{
  "name": "auto-mm-servis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "serve -l 4173 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prerender": "node scripts/prerender-services.mjs",
    "test": "playwright test",
    "lighthouse": "npx -y lighthouse@12 http://localhost:4173/ --quiet --chrome-flags=\"--headless=new\" --only-categories=performance,accessibility,best-practices,seo --output=html --output=json --output-path=qa/lighthouse",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "typescript": "^7.0.2"
  }
}
